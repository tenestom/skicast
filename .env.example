# SkiCast Environment Variables
# Copy to .env.local for local development

# ─── Frontend (Vite — must start with VITE_) ─────────────────

# Signaling server WebSocket URL
# Local dev:  ws://localhost:3001
# Production: wss://your-signaling-server.onrender.com
VITE_SIGNALING_URL=ws://localhost:3001

# TURN server (optional — needed when STUN fails on 5G/CGNAT)
# Provision from Twilio, Metered.ca (free tier), or self-host coturn
# VITE_TURN_URL=turns:your-turn-server.example.com:5349
# VITE_TURN_USERNAME=your-username
# VITE_TURN_CREDENTIAL=your-credential
